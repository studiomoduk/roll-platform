# ---- Database (Supabase Postgres) ----
# Use the "Connection string" from Supabase > Project Settings > Database.
# Prefer the pooled (pgbouncer, port 6543) URL for the app runtime,
# and the direct (port 5432) URL for migrations.
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ---- Supabase (auth + storage) ----
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."          # server-only, never expose to client
SUPABASE_STORAGE_BUCKET="palava-print"   # print TIFFs + work orders

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Production engine (Python FastAPI worker) ----
PRODUCTION_ENGINE_URL="http://localhost:8000"
PRODUCTION_ENGINE_TOKEN="dev-shared-secret"   # simple bearer auth between web <-> engine
