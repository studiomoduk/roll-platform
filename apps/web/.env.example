# apps/web reads the same variables documented in the repo-root .env.example.
# For local dev, create apps/web/.env.local with at least:
#
#   DATABASE_URL=...
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Stripe + Supabase + engine vars are optional in dev:
#   - without STRIPE_SECRET_KEY, checkout marks the order paid immediately
#   - without PRODUCTION_ENGINE_URL, jobs stay "queued"
#
# See ../../.env.example for the full list.
